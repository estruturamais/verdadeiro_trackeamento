name = "tracking-worker"
main = "src/worker/index.js"
compatibility_date = "2024-01-01"
workers_dev = false

routes = [
  { pattern = "{YOUR_DOMAIN}/collect/*", zone_name = "{YOUR_DOMAIN}" },
  { pattern = "{YOUR_DOMAIN}/tracking/*", zone_name = "{YOUR_DOMAIN}" },
  { pattern = "{YOUR_DOMAIN}/scripts/*", zone_name = "{YOUR_DOMAIN}" },
  { pattern = "{YOUR_DOMAIN}/g/*", zone_name = "{YOUR_DOMAIN}" }
]

# Sincroniza src/web-template.txt a partir de src/web.js antes de cada deploy/dev.
# Roda automaticamente em qualquer `wrangler deploy`/`dev` (Windows, macOS, Linux),
# garantindo que o Worker sempre sirva a versao atual do script de tracking.
[build]
command = "node scripts/sync-webtemplate.mjs"

# Retencao automatica de dados — executa diariamente as 03:00 UTC
# Apaga events com mais de 7 dias, webhook_raw com mais de 14 dias, user_store sem atualizacao ha mais de 90 dias
[triggers]
crons = ["0 3 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "tracking_db"
database_id = "{YOUR_D1_DATABASE_ID}"

[vars]
# Cole aqui o JSON do config.example.json preenchido com seus valores reais.
# IMPORTANTE: Não inclua access tokens ou api secrets aqui — use wrangler secret bulk.
SITE_CONFIG = '{}'

# Secrets a configurar via CLI (nunca neste arquivo). Comando canonico — portavel em
# bash, zsh e PowerShell — a partir de um secrets.json temporario:
#
#   npx wrangler secret bulk secrets.json
#   rm secrets.json          # PowerShell: Remove-Item secrets.json -Force
#
# Chaves possiveis no secrets.json:
#   META_ACCESS_TOKEN    (um unico token cobre todos os pixels, inclusive espelhos)
#   TIKTOK_ACCESS_TOKEN
#   GA4_API_SECRET
#   LOG_BEARER_TOKEN
#
# NUNCA subir por pipe (echo "valor" | wrangler secret put NOME): no Windows/PowerShell o pipe
# acrescenta CRLF, o secret fica com whitespace e os envios falham com status_code = 0 +
# "Error: Network connection lost." — que parece erro de rede, mas e o valor no cofre.
