{
  "site_id": "curso-marketing-digital",
  "debug": false,
  "platforms": {
    "ga4": {
      "measurement_id": "G-ABC123DEF4"
    },
    "meta": {
      "pixel_id": "111111111111111",
      "pixel_ids_mirror": ["222222222222222"]
    },
    "tiktok": {
      "pixel_id": "CP1234567890ABCDEF",
      "access_token": "{EXCECAO: TikTok nao faz fallback para env — incluir o access_token aqui, nao como wrangler secret}"
    },
    "google_ads": {
      "conversion_id": "AW-123456789",
      "channel": "server",
      "conversion_label_contact": "AbCdEf123",
      "conversion_label_lead": "GhIjKl456",
      "conversion_label_purchase": "MnOpQr789"
    },
    "sheets": {
      "id_script": "AKfycbwEXEMPLO0000000000000000000000000000000000000000",
      "events": ["lead"],
      "page_event_names": { "registrol20": "L20_LG_SLPC", "brasilia": "BSB_LEAD" }
    }
  },
  "spa_mode": {
    "_doc": "IZZO-14/QZIC — opt-in. Ligar SO se houver funil de quiz/SPA (Next.js/React/XQuiz/Cakto) cujo botao de compra copia window.location.search para o checkout. `locations` escopa ONDE o modo SPA vale e PRE-FIXA o gateway de cada local: `match` = prefixo de slug ('/quiz') ou host ('quiz.seusite.com'); `gateways` = qual gateway aquele local usa (o marca_user entra no indexador desse gateway -> viabiliza o FDV merge no Purchase). Paginas fora das locations seguem tradicionais (sem poluicao de URL; initiate_checkout via link_click). Sem `locations` e com enabled:true, o dominio inteiro vira SPA (usa spa_mode.gateways). Deixe enabled:false em sites 100% tradicionais.",
    "enabled": false,
    "locations": [
      { "match": "/quiz", "gateways": ["lastlink"] }
    ]
  },
  "disable_url_rewrite": false,
  "gateways": ["hotmart", "kiwify", "hubla", "payt"],
  "gateways_config": {
    "hotmart": {
      "domains": ["hotmart.com", "pay.hotmart.com"],
      "caminho": "sck",
      "indexador": "xcod",
      "user_params": { "email": "email", "phone": "phonenumber", "name": "name" }
    },
    "hubla": {
      "domains": ["hubla.com.br", "pay.hubla.com.br", "checkout.hubla.com.br"],
      "caminho": "caminho",
      "indexador": "marca_user"
    },
    "payt": {
      "domains": ["payt.com.br", "checkout.payt.com.br", "payt.site"],
      "caminho": "caminho",
      "indexador": "src"
    }
  },
  "triggers": {
    "lead": {
      "type": "form_submit",
      "selectors": { "elementor": true, "cf7": true, "generic": true }
    },
    "contact": {
      "type": "link_click",
      "match": "wa.me|api.whatsapp"
    },
    "initiate_checkout": {
      "type": "link_click",
      "match": "pay|eduzz"
    }
  },
  "custom_data": {
    "page_type": {
      "conditions": [
        { "if": "document.title.includes('vendas')", "value": "vendas" }
      ],
      "fallback": "outras"
    }
  },
  "qualification": {
    "form_signature": "form_fields[q1]",
    "datalayer_event": "vt_qualify",
    "contact_fields": { "name": "form_fields[nome]", "email": "form_fields[email]", "phone": "form_fields[whatsapp]" },
    "extra_fields": { "instagram": "form_fields[instagram]" },
    "questions": [
      { "id": "q1", "field": "form_fields[q1]", "weight": 0.30, "sheet_col": "faturamento", "value_map": { "Acima de 50 mil": "A", "10 a 50 mil": "B", "Menos de 10 mil": "C", "Nao faturo ainda": "X" } },
      { "id": "q2", "field": "form_fields[q2]", "weight": 0.20, "sheet_col": "tempo", "value_map": { "Mais de 2 anos": "A", "6 a 24 meses": "B", "Menos de 6 meses": "C" } },
      { "id": "q3", "field": "form_fields[q3]", "weight": 0.30, "sheet_col": "investir", "value_map": { "Sim, com orcamento": "A", "Talvez": "B", "Nao posso investir": "X" } },
      { "id": "q4", "field": "form_fields[q4]", "weight": 0.20, "sheet_col": "iniciar", "value_map": { "Imediatamente": "A", "Nas proximas semanas": "B", "Sem previsao": "C" } }
    ],
    "letter_values": { "A": 0.85, "B": 0.55, "C": 0.30, "X": 0.10 },
    "dq_letter": "X",
    "result_field": "form_fields[resultado]"
  },
  "cookies": {
    "user": "marca_user",
    "email": "marca_email",
    "phone": "marca_phone",
    "name": "marca_name"
  },
  "logging": {
    "enabled": true,
    "retention_days": 30,
    "log_bearer_token": "{token-secreto-opcional}"
  },
  "retention": {
    "mode": "auto_clean",
    "when_full": "recycle_oldest"
  },
  "utm_convention": {
    "creative": "utm_content",
    "adset": "utm_term",
    "campaign": "utm_campaign",
    "source": "utm_source",
    "paid_signal": { "field": "utm_medium", "equals": "paid" },
    "custom": false
  }
}
